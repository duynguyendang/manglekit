package main

import (
	"context"
	"testing"

	"github.com/duynguyendang/manglekit/core"
	"github.com/duynguyendang/manglekit/sdk"
)

func newTestClient(t *testing.T) *sdk.Client {
	t.Helper()
	ctx := context.Background()
	client, err := sdk.NewClient(ctx, sdk.WithPolicyPath("policy.dl"))
	if err != nil {
		t.Fatalf("init client: %v", err)
	}
	t.Cleanup(func() { _ = client.Shutdown(ctx) })
	return client
}

// TestSkill_Allowed: clean input passes the policy gate.
func TestSkill_Allowed(t *testing.T) {
	client := newTestClient(t)
	skill := newSkill(client)

	out, err := skill.Run(context.Background(), {{.Pascal}}Request{Text: "hello"})
	if err != nil {
		t.Fatalf("expected allowed, got error: %v", err)
	}
	if out.Result == "" {
		t.Fatal("expected non-empty result")
	}
}

// TestSkill_Blocked: input flagged via metadata is blocked fail-closed.
func TestSkill_Blocked(t *testing.T) {
	client := newTestClient(t)
	_ = newSkill(client) // register the action in the client's registry
	ctx := context.Background()

	_, err := client.ExecuteByName(ctx, "{{.Snake}}", {{.Pascal}}Request{Text: "hello"}, sdk.WithMetadata("blocked", "true"))
	if err == nil {
		t.Fatal("expected policy block, got nil error")
	}
	if !core.IsPolicyViolationError(err) {
		t.Fatalf("expected PolicyViolationError, got %v", err)
	}
}
