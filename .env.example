# Google API Key (for embedding in hybrid_rag example)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Key (for LLM in hybrid_rag example)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Base URL (optional, for OpenAI-compatible services like Ollama, LocalAI, OpenRouter)
# Leave empty to use default OpenAI API
OPENAI_BASE_URL=

# OpenAI Model (optional, defaults to gpt-3.5-turbo)
OPENAI_MODEL=
