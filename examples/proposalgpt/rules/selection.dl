Decl selected_playbook(Playbook).
Decl config(Key, Val).
Decl platform_choice(Platform).

% Select "Modernization" if keywords "legacy" or "monolith" exist.
selected_playbook("modernization") :- has_keyword("monolith").
selected_playbook("modernization") :- has_keyword("legacy").

% Select "Greenfield" if "scratch" or "new app" exists.
selected_playbook("greenfield") :- has_keyword("build from scratch").
selected_playbook("greenfield") :- has_keyword("new app").

% Select "Data Platform Modernization" if "data warehouse" and "slow queries" exist.
selected_playbook("data_platform") :- 
    has_keyword("data lake"),
    has_keyword("modernization").
selected_playbook("data_platform") :- 
    has_keyword("data warehouse"),
    has_keyword("performance issues").

% Select "Lift & Shift"
selected_playbook("lift_and_shift") :- has_keyword("lift and shift").
selected_playbook("lift_and_shift") :- has_keyword("datacenter exit").

% Select "Feature Enhancement"
selected_playbook("feature_enhancement") :- has_keyword("new feature").
selected_playbook("feature_enhancement") :- has_keyword("addon").

% Select "Data Migration"
selected_playbook("data_migration") :- has_keyword("data migration").
selected_playbook("data_migration") :- has_keyword("transfer data").

% Select "Report Migration"
selected_playbook("report_migration") :- has_keyword("bi migration").
selected_playbook("report_migration") :- has_keyword("tableau").
selected_playbook("report_migration") :- has_keyword("power bi").

% Select "Platform Setup"
selected_playbook("platform_setup") :- has_keyword("platform engineering").
selected_playbook("platform_setup") :- has_keyword("developer experience").

% Select "AI/ML Platform"
selected_playbook("ai_ml_platform") :- has_keyword("mlops").
selected_playbook("ai_ml_platform") :- has_keyword("machine learning").

% Select "CRM Implementation"
selected_playbook("crm_implementation") :- has_keyword("crm").
selected_playbook("crm_implementation") :- has_keyword("salesforce").
selected_playbook("crm_implementation") :- has_keyword("dynamics").

% Map selection to config for Go retrieval
config("playbook_id", P) :- selected_playbook(P).

Decl playbook_filename(Playbook, Filename).
playbook_filename("greenfield", "greenfield.md").
playbook_filename("modernization", "modernization.md").
playbook_filename("lift_and_shift", "lift_and_shift.md").
playbook_filename("feature_enhancement", "feature_enhancement.md").
playbook_filename("data_migration", "data_migration.md").
playbook_filename("report_migration", "report_migration.md").
playbook_filename("platform_setup", "platform_setup.md").
playbook_filename("data_platform", "data_platform.md").
playbook_filename("ai_ml_platform", "ai_ml_platform.md").
playbook_filename("crm_implementation", "crm_implementation.md").

config("playbook_file", F) :- selected_playbook(P), playbook_filename(P, F).

% Also map platform_choice
config("platform", P) :- platform_choice(P).

