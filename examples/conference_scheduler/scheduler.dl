# Conference Scheduler Rules

# 1. Halt if a speaker is double-booked
halt(Reason) :-
    schedule(Speaker, Time, Room1),
    schedule(Speaker, Time, Room2),
    Room1 != Room2,
    Reason = "Speaker double-booked".

# 2. Halt if a room is double-booked
halt(Reason) :-
    schedule(Speaker1, Time, Room),
    schedule(Speaker2, Time, Room),
    Speaker1 != Speaker2,
    Reason = "Room double-booked".

# 3. Retry if missing information (e.g. no time assigned)
retry(Feedback) :-
    input_request(Speaker, "schedule"),
    not schedule(Speaker, _, _),
    Feedback = "Please assign a time and room for the speaker".
