// --- Input Predicates (from Converters) ---
.input query_token(Token).
.input triple(Subject, Predicate, Object). // From the RDFParser

// --- Output Predicate (Instruction for the Retriever) ---
.output query_filter(Key, Value).

// --- LOGICAL INFERENCE RULES ---

// Step 1: Extract the entity the user is asking about.
// An entity is a token from the query that also exists as a subject in our knowledge base.
query_entity(Entity) :-
  query_token(Entity),
  triple(Entity, _, _).

// Step 2: Find the document that describes the extracted entity.
target_document(Doc) :-
  query_entity(Entity),
  triple(Doc, "<http://manglekit.dev/ontology#describes>", Entity).

// Step 3 (CRITICAL): Generate the filter instruction for the retriever.
// Create a filter to fetch ONLY the document we logically deduced.
// We use the 'id' metadata field, which we defined in the markdown front matter.
query_filter("id", Doc) :- target_document(Doc).