user_attribute("user_id","alice").
user_attribute("role","analyst").
user_attribute("department","sales").
user_attribute("doc_id","A123").
user_attribute("purpose","analytics").

doc(doc1).
doc_id(doc1,"A123").
doc_department(doc1,"sales").
doc_confidentiality(doc1,"normal").
column(doc1,"customer_name"). column(doc1,"email"). column(doc1,"revenue"). column(doc1,"notes").
sensitive_column(doc1,"email"). sensitive_column(doc1,"notes").

doc(doc2).
doc_id(doc2,"B456").
doc_department(doc2,"marketing").
doc_confidentiality(doc2,"high").
column(doc2,"lead_name"). column(doc2,"email"). column(doc2,"score").
sensitive_column(doc2,"email").

doc(doc3).
doc_id(doc3,"S777").
doc_department(doc3,"sales").
doc_confidentiality(doc3,"restricted").
column(doc3,"account"). column(doc3,"deal_size"). column(doc3,"owner"). column(doc3,"notes").
sensitive_column(doc3,"notes").

allowed_agg("sum"). allowed_agg("avg"). allowed_agg("count").
joinable(doc1,"customer_name",doc3,"account").

privileged_user() :- user_attribute("role","admin").
privileged_user() :- user_attribute("role","security").

same_department(D) :- user_attribute("department",Dept), doc_department(D,Dept).

pre_retrieve(D) :- user_attribute("doc_id",ID), doc_id(D,ID).
pre_retrieve(D) :- same_department(D), doc_confidentiality(D,"normal").
pre_retrieve(D) :- privileged_user(), doc(D).

deny_retrieve(D) :- doc_confidentiality(D,"restricted"), !privileged_user().

can_retrieve(D) :- pre_retrieve(D), !deny_retrieve(D).

visible_column(D,C) :- column(D,C), !sensitive_column(D,C), can_retrieve(D).
visible_column(D,C) :- column(D,C), sensitive_column(D,C), privileged_user(), can_retrieve(D).

mask_strategy("hash") :- user_attribute("purpose","analytics"), !privileged_user().
mask_strategy("redact") :- !privileged_user(), !user_attribute("purpose","analytics").

masked_column(D,C,M) :- column(D,C), sensitive_column(D,C), can_retrieve(D), mask_strategy(M).

allow_function(F) :- privileged_user().
allow_function(F) :- allowed_agg(F).

has_visible_column(D) :- visible_column(D,C).
can_chat_with_data(D) :- can_retrieve(D), has_visible_column(D).

allow_join(A,CA,B,CB) :- can_chat_with_data(A), can_chat_with_data(B), joinable(A,CA,B,CB).
