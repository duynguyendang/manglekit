# This policy controls access to documents based on user attributes and document properties.

# --- Predicate Declarations ---
# Explicitly declare all predicates and their types. This is required by the
# Mangle Datalog engine for static analysis.
.decl flow_static(flowName: symbol, stage: symbol)
.decl flow(flowName: symbol, stage: symbol)
.decl deny(user: symbol, docID: symbol)
.decl allow(user: symbol, docID: symbol)
.decl request(user: symbol, docID: symbol)
.decl user_attribute(user: symbol, key: symbol, value: symbol)
.decl doc_id(internalID: symbol, externalID: symbol)
.decl doc_department(internalID: symbol, department: symbol)
.decl doc_confidentiality(internalID: symbol, level: symbol)


# --- Flow Definition (Union Pattern) ---
# Define the static flow and unify it into the main 'flow' predicate that the
# orchestrator queries. This is the correct, idiomatic way to do this.
flow_static("access-control", "pre").
flow(F, S) :- flow_static(F, S).


# --- Deny Rule ---
# This is the entry point for the policy. It uses the 'not' keyword for negation.
deny(User, ExternalDocID) :-
  request(User, ExternalDocID),
  not allow(User, ExternalDocID).


# --- Allow Rules ---
allow(User, ExternalDocID) :-
  request(User, ExternalDocID),
  user_attribute(User, "role", "analyst"),
  user_attribute(User, "department", "sales"),
  doc_id(InternalDocID, ExternalDocID),
  doc_department(InternalDocID, "sales").

allow(User, ExternalDocID) :-
  request(User, ExternalDocID),
  doc_id(InternalDocID, ExternalDocID),
  doc_confidentiality(InternalDocID, "normal").

allow(User, ExternalDocID) :-
  request(User, ExternalDocID),
  user_attribute(User, "doc_id", ExternalDocID).