@prefix ex: <http://example.org/> .

# Alice is rich
ex:Alice ex:rich "true" .

# Bob is guaranteed by Alice
ex:Bob ex:guarantor ex:Alice .

# Charlie is guaranteed by Bob (recursive)
ex:Charlie ex:guarantor ex:Bob .

# Eve is not rich (no rich triple)
# David is guaranteed by Eve
ex:David ex:guarantor ex:Eve .

# Loan Requests
ex:Req1 ex:request_loan ex:Alice .
ex:Req2 ex:request_loan ex:Charlie .
ex:Req3 ex:request_loan ex:David .
