Decl flow(Flow).
Decl flow_stage(Flow, Order, Stage).
Decl stage_tool(Stage, Tool).
Decl skip_stage(Stage).

Decl threshold(Value).
Decl deny(Reason).
Decl best_score(Value).
Decl doc_metadata(DocID, Key, Value).
Decl doc_content(DocID, Text).
Decl user_attribute(Key, Value).
Decl drop_doc(DocID, Reason).
Decl redact(Label).
Decl doc_text(Text).
Decl raw_query(Query).

flow("main_flow").

flow_stage("main_flow", 5, "pre_rules_stage").
stage_tool("pre_rules_stage", "mangle_rules").

flow_stage("main_flow", 10, "retrieval_stage").
stage_tool("retrieval_stage", "hybrid_search").

flow_stage("main_flow", 20, "post_rules_stage").
stage_tool("post_rules_stage", "mangle_rules").

flow_stage("main_flow", 30, "llm_stage").
stage_tool("llm_stage", "chat_llm").

skip_stage("llm_stage") :-
  raw_query(Query),
  :string:contains(Query, "(no_llm)").

threshold(0.35).
deny("low_confidence") :-
  best_score(S),
  threshold(T),
  S < T.

drop_doc(DocID, "requires_employee") :-
  doc_metadata(DocID, "visibility", "internal"),
  user_attribute("role", Role),
  Role != "employee".

redact("phone") :-
  doc_content(DocID, Text),
  :string:contains(Text, "123-456-7890").
