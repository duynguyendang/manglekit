Decl user_attribute(Key, Value).
Decl doc_id(Doc, Id).

Decl requested_doc_id(Id).
Decl target_doc(Doc).
Decl query_filter(Key, Value).

requested_doc_id(DocID) :-
  user_attribute("doc_id", DocID).

target_doc(D) :-
  requested_doc_id(ReqID),
  doc_id(D, ReqID).

query_filter("id", D) :-
  target_doc(D).

query_filter("doc_id", ReqID) :-
  requested_doc_id(ReqID).
