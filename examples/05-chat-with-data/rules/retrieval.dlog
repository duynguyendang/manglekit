Decl requested_doc_id(Id).
Decl current_user(User).
Decl user_attribute(User, Key, Value).
Decl doc_id(Doc, Id).
Decl doc_department(Doc, Dept).
Decl doc_confidentiality(Doc, Level).

requested_doc_id(DocID) :-
  current_user(U),
  user_attribute(U, "doc_id", DocID).

target_doc(D) :-
  requested_doc_id(ReqID),
  doc_id(D, ReqID).

query_filter("id", D) :-
  target_doc(D).