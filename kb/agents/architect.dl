% ==========================================
% ARCHITECT AGENT DEFINITION
% Tier 1 Governance - Agent Role and Capabilities
% ==========================================

% Agent role definition
agent_role("architect").

% ==========================================
% ARCHITECT CAPABILITIES
% ==========================================

role_capability("architect", "read_code").
role_capability("architect", "analyze_arch").
role_capability("architect", "generate_csd").
role_capability("architect", "review_design").
role_capability("architect", "validate_patterns").
role_capability("architect", "dependency_analysis").
role_capability("architect", "llm_reasoning").

% ==========================================
% TASK TYPES FOR ARCHITECT
% ==========================================

task_requires_capability("architectural_analysis", "read_code").
task_requires_capability("architectural_analysis", "analyze_arch").
task_requires_capability("architectural_analysis", "dependency_analysis").

task_requires_capability("csd_generation", "generate_csd").
task_requires_capability("csd_generation", "llm_reasoning").
task_requires_capability("csd_generation", "validate_patterns").

task_requires_capability("design_review", "review_design").
task_requires_capability("design_review", "validate_patterns").

% ==========================================
% AGENT INSTANCES
% ==========================================

agent("architect-001", "architect").
agent("architect-002", "architect").

% Agent capabilities (instance-level)
agent_capability("architect-001", "read_code").
agent_capability("architect-001", "analyze_arch").
agent_capability("architect-001", "generate_csd").
agent_capability("architect-001", "review_design").
agent_capability("architect-001", "dependency_analysis").
agent_capability("architect-001", "llm_reasoning").

agent_capability("architect-002", "read_code").
agent_capability("architect-002", "analyze_arch").
agent_capability("architect-002", "generate_csd").

% ==========================================
% AGENT CONFIGURATION
% ==========================================

agent_config("architect-001", "model", "gpt-4o").
agent_config("architect-001", "temperature", "0.3").
agent_config("architect-001", "max_tokens", "8000").
agent_config("architect-001", "csd_template", "standard").
agent_config("architect-001", "include_diagrams", "true").

agent_config("architect-002", "model", "gpt-4o").
agent_config("architect-002", "temperature", "0.4").
agent_config("architect-002", "max_tokens", "6000").

% ==========================================
% AGENT STATUS
% ==========================================

agent_status("architect-001", "available").
agent_status("architect-002", "available").

% ==========================================
% TIER 0: ARCHITECTURAL AXIOMS
% Immutable truths that must always be followed
% ==========================================

% All external endpoints must use HTTPS
axiom("external_endpoints_must_use_https").
axiom("no_hardcoded_secrets").
axiom("all_code_must_have_tests").

% ==========================================
% TIER 1: GOVERNANCE RULES
% Rules enforced by human operators
% ==========================================

% Must use parameterized queries to prevent SQL injection
governance_rule("no_sql_injection") :-
    not allowed_external_endpoint(Endpoint),
    Endpoint = "sql_query".

allowed_external_endpoint(Endpoint) :-
    external_endpoint(Endpoint),
    uses_https(Endpoint).

% Must have error handling
governance_rule("error_handling_required") :-
    api_handler(Handler),
    not has_error_handler(Handler).

has_error_handler(Handler) :-
    api_handler(Handler),
    code_contains(Handler, "try").

has_error_handler(Handler) :-
    api_handler(Handler),
    code_contains(Handler, "catch").

% ==========================================
% TIER 2: INDUCED RULES
% Learned patterns from codebase analysis
% ==========================================

% Common architectural patterns detected
pattern("microservice") :- 
    has_multiple_services(_),
    uses_rest_api(_).

pattern("event_driven") :-
    has_message_queue(_),
    has_event_handlers(_).

pattern("layered_architecture") :-
    has_controller(_),
    has_service_layer(_),
    has_repository(_).

% ==========================================
% TIER 3: UNTRUSTED INPUT
% External data must be sanitized
% ==========================================

untrusted_input(UserInput) :-
    http_request_param(_, UserInput).

untrusted_input(UserInput) :-
    http_request_body(_, UserInput).

untrusted_input(UserInput) :-
    cli_argument(UserInput).

% Must validate untrusted input
governance_rule("validate_untrusted_input") :-
    untrusted_input(Input),
    not input_validated(Input).

input_validated(Input) :-
    sanitization_rule(_, Input).
