agent_capability("reviewer-001", "rule_validation").
agent_capability("reviewer-001", "approval").

% Refiner capabilities
agent_capability("refiner-001", "error_correction").
agent_capability("refiner-001", "quality_optimization").
agent_capability("refiner-001", "patch_generation").

% Coordinator capabilities
agent_capability("coordinator-001", "workflow_orchestration").
agent_capability("coordinator-001", "agent_synchronization").
agent_capability("coordinator-001", "state_management").
agent_capability("coordinator-001", "error_recovery").

% ==========================================
% AGENT CONFIGURATION
% ==========================================

agent_config("observer-001", "model", "gpt-4o").
agent_config("observer-001", "temperature", "0.5").
agent_config("observer-001", "max_tokens", "4000").

agent_config("observer-002", "model", "gpt-4o").
agent_config("observer-002", "temperature", "0.3").
agent_config("observer-002", "max_tokens", "4000").

agent_config("orienter-001", "model", "gpt-4o").
agent_config("orienter-001", "temperature", "0.4").
agent_config("orienter-001", "max_tokens", "6000").

agent_config("orienter-002", "model", "gpt-4o").
agent_config("orienter-002", "temperature", "0.3").
agent_config("orienter-002", "max_tokens", "4000").

agent_config("planner-001", "model", "gpt-4o").
agent_config("planner-001", "temperature", "0.3").
agent_config("planner-001", "max_tokens", "8000").
agent_config("planner-001", "max_plan_depth", "10").

agent_config("executor-001", "model", "gpt-4o").
agent_config("executor-001", "temperature", "0.7").
agent_config("executor-001", "timeout_ms", "60000").
agent_config("executor-001", "max_retries", "3").

agent_config("executor-002", "model", "gpt-4o").
agent_config("executor-002", "temperature", "0.7").
agent_config("executor-002", "timeout_ms", "30000").
agent_config("executor-002", "max_retries", "2").

agent_config("reviewer-001", "model", "gpt-4o").
agent_config("reviewer-001", "temperature", "0.2").
agent_config("reviewer-001", "strict_mode", "true").
agent_config("reviewer-001", "fail_threshold", "0.8").

agent_config("refiner-001", "model", "gpt-4o").
agent_config("refiner-001", "temperature", "0.4").
agent_config("refiner-001", "max_iterations", "3").
agent_config("refiner-001", "improvement_threshold", "0.1").

agent_config("coordinator-001", "max_parallel", "5").
agent_config("coordinator-001", "checkpoint_interval", "30").
agent_config("coordinator-001", "timeout_ms", "120000").

% ==========================================
% AGENT STATUS
% ==========================================

agent_status("observer-001", "available").
agent_status("observer-002", "available").
agent_status("orienter-001", "available").
agent_status("orienter-002", "available").
agent_status("planner-001", "available").
agent_status("executor-001", "available").
agent_status("executor-002", "available").
agent_status("reviewer-001", "available").
agent_status("refiner-001", "available").
agent_status("coordinator-001", "available").

% ==========================================
% COMMUNICATION PROTOCOLS
% ==========================================

communication_protocol("request_response").
communication_protocol("publish_subscribe").
communication_protocol("broadcast").
communication_protocol("streaming").

role_protocol("observer", "publish_subscribe").
role_protocol("orienter", "request_response").
role_protocol("planner", "request_response").
role_protocol("executor", "request_response").
role_protocol("reviewer", "request_response").
role_protocol("refiner", "request_response").
role_protocol("coordinator", "broadcast").

% ==========================================
% AGENT SELECTION HELPERS
% ==========================================

% Select agent for a specific phase
select_agent_for_phase(Phase, Agent) :-
    role_ooda_phase(Role, Phase),
    agent(Agent, Role),
    agent_status(Agent, "available").

% Get agents by capability
agents_with_capability(Capability, Agents) :-
    findall(Agent, 
        (agent(Agent, _), agent_capability(Agent, Capability)),
        Agents).

% Check if agent can perform task
can_perform_task(Agent, Task) :-
    agent(Agent, Role),
    role_capability(Role, Capability),
    task_requires_capability(Task, Capability).

can_perform_task(Agent, Task) :-
    agent_capability(Agent, Capability),
    task_requires_capability(Task, Capability).
