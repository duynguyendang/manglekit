% ==========================================
% TEMPLATE REGISTRY - Generic Document Templates
% ==========================================

% ==========================================
% TEMPLATE DEFINITIONS
% ==========================================

template("document", "Generic Document").
template("report", "Generic Report").
template("specification", "Specification Document").
template("guide", "How-To Guide").
template("reference", "Reference Document").
template("decision", "Decision Record").

% ==========================================
% TEMPLATE SECTIONS
% ==========================================

% Generic document sections
template_section("document", 1, "Title", "required").
template_section("document", 2, "Metadata", "required").
template_section("document", 3, "Summary", "required").
template_section("document", 4, "Content", "required").
template_section("document", 5, "Conclusion", "optional").
template_section("document", 6, "Appendices", "optional").

% Report sections
template_section("report", 1, "Executive Summary", "required").
template_section("report", 2, "Introduction", "required").
template_section("report", 3, "Methodology", "required").
template_section("report", 4, "Findings", "required").
template_section("report", 5, "Analysis", "required").
template_section("report", 6, "Recommendations", "required").
template_section("report", 7, "Conclusion", "required").
template_section("report", 8, "Appendices", "optional").

% Specification sections
template_section("specification", 1, "Overview", "required").
template_section("specification", 2, "Requirements", "required").
template_section("specification", 3, "Design", "required").
template_section("specification", 4, "Implementation", "required").
template_section("specification", 5, "Testing", "required").
template_section("specification", 6, "Acceptance Criteria", "required").

% Guide sections
template_section("guide", 1, "Introduction", "required").
template_section("guide", 2, "Prerequisites", "required").
template_section("guide", 3, "Steps", "required").
template_section("guide", 4, "Examples", "optional").
template_section("guide", 5, "Troubleshooting", "optional").
template_section("guide", 6, "FAQ", "optional").

% Reference sections
template_section("reference", 1, "Overview", "required").
template_section("reference", 2, "API Reference", "required").
template_section("reference", 3, "Configuration", "optional").
template_section("reference", 4, "Examples", "optional").
template_section("reference", 5, "Changelog", "optional").

% Decision sections
template_section("decision", 1, "Title", "required").
template_section("decision", 2, "Status", "required").
template_section("decision", 3, "Context", "required").
template_section("decision", 4, "Decision", "required").
template_section("decision", 5, "Consequences", "required").
template_section("decision", 6, "Related Decisions", "optional").

% ==========================================
% TEMPLATE METADATA
% ==========================================

template_metadata("document", "min_length", "100").
template_metadata("document", "max_length", "10000").
template_metadata("document", "format", "markdown").

template_metadata("report", "min_length", "500").
template_metadata("report", "max_length", "50000").
template_metadata("report", "format", "markdown").

template_metadata("specification", "min_length", "500").
template_metadata("specification", "max_length", "30000").
template_metadata("specification", "format", "markdown").

template_metadata("guide", "min_length", "200").
template_metadata("guide", "max_length", "20000").
template_metadata("guide", "format", "markdown").

template_metadata("reference", "min_length", "300").
template_metadata("reference", "max_length", "50000").
template_metadata("reference", "format", "markdown").

template_metadata("decision", "min_length", "100").
template_metadata("decision", "max_length", "5000").
template_metadata("decision", "format", "markdown").

% ==========================================
% TEMPLATE → OODA PHASE MAPPING
% ==========================================

template_ooda_phase("document", "act").
template_ooda_phase("report", "act").
template_ooda_phase("specification", "decide").
template_ooda_phase("guide", "act").
template_ooda_phase("reference", "orient").
template_ooda_phase("decision", "decide").

% ==========================================
% TEMPLATE HELPERS
% ==========================================

% Get sections for template
template_sections(Type, Sections) :-
    findall(section(N, Name, Req), 
        template_section(Type, N, Name, Req),
        Sections).

% Count required sections
count_required_sections(Type, Count) :-
    findall(Name, template_section(Type, _, Name, "required"), Required),
    length(Required, Count).

% Get templates by OODA phase
templates_for_phase(Phase, Templates) :-
    findall(Template, 
        template_ooda_phase(Template, Phase),
        Templates).
