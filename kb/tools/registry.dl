% ==========================================
% TOOL CONFIGURATION
% ==========================================

tool_config("semantic_search", "model", "text-embedding-3-small").
tool_config("semantic_search", "top_k", "10").
tool_config("semantic_search", "min_score", "0.7").

tool_config("llm_generate", "model", "gpt-4o").
tool_config("llm_generate", "temperature", "0.7").
tool_config("llm_generate", "max_tokens", "4000").
tool_config("llm_generate", "timeout_ms", "60000").

tool_config("code_generator", "model", "gpt-4o").
tool_config("code_generator", "temperature", "0.3").
tool_config("code_generator", "max_tokens", "8000").

tool_config("schema_validator", "strict_mode", "false").
tool_config("schema_validator", "allow_additional", "true").

tool_config("linter", "ruleset", "default").
tool_config("linter", "fail_on_warning", "false").
tool_config("linter", "max_violations", "100").

tool_config("http_client", "timeout_ms", "30000").
tool_config("http_client", "max_retries", "3").
tool_config("http_client", "retry_delay_ms", "1000").

tool_config("file_system", "encoding", "utf-8").
tool_config("file_system", "create_dirs", "true").
tool_config("file_system", "overwrite", "false").

tool_config("database_client", "connection_timeout_ms", "10000").
tool_config("database_client", "query_timeout_ms", "30000").
tool_config("database_client", "pool_size", "10").

% ==========================================
% TOOL AVAILABILITY
% ==========================================

tool_available("semantic_search", "available").
tool_available("llm_generate", "available").
tool_available("code_generator", "available").
tool_available("entity_extractor", "available").
tool_available("schema_validator", "available").
tool_available("linter", "available").
tool_available("formatter", "available").
tool_available("http_client", "available").
tool_available("file_system", "available").
tool_available("database_client", "available").

% ==========================================
% TOOL COST ESTIMATION
% ==========================================

tool_cost("semantic_search", "per_call", "0.0001").
tool_cost("llm_generate", "per_token", "0.00001").
tool_cost("code_generator", "per_token", "0.00001").
tool_cost("http_client", "per_request", "0.00001").
tool_cost("database_client", "per_query", "0.000001").

% ==========================================
% TOOL → OODA PHASE MAPPING
% ==========================================

tool_ooda_phase("semantic_search", "observe").
tool_ooda_phase("keyword_search", "observe").
tool_ooda_phase("entity_extractor", "observe").

tool_ooda_phase("pattern_matcher", "orient").
tool_ooda_phase("sentiment_analyzer", "orient").

tool_ooda_phase("llm_generate", "act").
tool_ooda_phase("code_generator", "act").
tool_ooda_phase("template_renderer", "act").
tool_ooda_phase("diagram_generator", "act").

tool_ooda_phase("schema_validator", "verify").
tool_ooda_phase("linter", "verify").
tool_ooda_phase("type_checker", "verify").
tool_ooda_phase("security_scanner", "verify").

tool_ooda_phase("formatter", "refine").
tool_ooda_phase("converter", "refine").

% ==========================================
% TOOL HELPERS
% ==========================================

% Get tools by category
tools_by_category(Category, Tools) :-
    findall(Tool, 
        (tool(Tool, Category), tool_available(Tool, "available")),
        Tools).

% Get tools by OODA phase
tools_for_phase(Phase, Tools) :-
    findall(Tool, 
        (tool_ooda_phase(Tool, Phase), tool_available(Tool, "available")),
        Tools).

% Get tools by capability
tools_with_capability(Capability, Tools) :-
    findall(Tool, 
        (tool(Tool, _), tool_capability(Tool, Capability)),
        Tools).

% Check if tool is available
is_tool_available(Tool) :-
    tool_available(Tool, "available").
