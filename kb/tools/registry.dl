% ==========================================
% TOOL REGISTRY - Generic Tools
% ==========================================

% ==========================================
% TOOL CATEGORIES
% ==========================================

tool_category("search").
tool_category("generation").
tool_category("analysis").
tool_category("validation").
tool_category("transformation").
tool_category("integration").

