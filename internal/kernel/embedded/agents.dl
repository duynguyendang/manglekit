% ==========================================
% AGENT REGISTRY - Generic Multi-Agent System
% ==========================================
% Domain-agnostic agent definitions aligned with OODA phases
% This file is embedded in manglekit binary

% ==========================================
% CORE AGENT ROLES (Aligned with OODA)
% ==========================================

agent_role("observer").
agent_role("orienter").
agent_role("planner").
agent_role("executor").
agent_role("reviewer").
agent_role("refiner").
agent_role("coordinator").

% ==========================================
% ROLE → OODA PHASE MAPPING
% ==========================================

role_ooda_phase("observer", "observe").
role_ooda_phase("orienter", "orient").
role_ooda_phase("planner", "decide").
role_ooda_phase("executor", "act").
role_ooda_phase("reviewer", "verify").
role_ooda_phase("refiner", "refine").
role_ooda_phase("coordinator", "observe").

% ==========================================
% ROLE CAPABILITIES
% ==========================================

role_capability("observer", "information_gathering").
role_capability("observer", "entity_extraction").
role_capability("observer", "context_capture").
role_capability("observer", "semantic_search").
role_capability("observer", "input_validation").

role_capability("orienter", "semantic_analysis").
role_capability("orienter", "pattern_recognition").
role_capability("orienter", "classification").
role_capability("orienter", "knowledge_retrieval").
role_capability("orienter", "context_synthesis").

role_capability("planner", "task_decomposition").
role_capability("planner", "goal_analysis").
role_capability("planner", "milestone_planning").
role_capability("planner", "plan_generation").
role_capability("planner", "risk_assessment").
role_capability("planner", "resource_planning").

role_capability("executor", "action_execution").
role_capability("executor", "tool_invocation").
role_capability("executor", "content_generation").
role_capability("executor", "code_generation").
role_capability("executor", "file_operations").
role_capability("executor", "api_calls").

role_capability("reviewer", "validation").
role_capability("reviewer", "quality_check").
role_capability("reviewer", "rule_validation").
role_capability("reviewer", "compliance_check").
role_capability("reviewer", "consistency_check").
role_capability("reviewer", "approval").

role_capability("refiner", "error_correction").
role_capability("refiner", "quality_optimization").
role_capability("refiner", "feedback_integration").
role_capability("refiner", "iterative_improvement").
role_capability("refiner", "patch_generation").

role_capability("coordinator", "workflow_orchestration").
role_capability("coordinator", "task_delegation").
role_capability("coordinator", "agent_synchronization").
role_capability("coordinator", "state_management").
role_capability("coordinator", "error_recovery").

% ==========================================
% ROLE INHERITANCE
% ==========================================

role_inherits("coordinator", "planner").
role_inherits("coordinator", "observer").
role_inherits("coordinator", "reviewer").

% ==========================================
% TASK REQUIREMENTS
% ==========================================

task_requires_capability("gather_information", "information_gathering").
task_requires_capability("extract_entities", "entity_extraction").
task_requires_capability("classify_input", "classification").
task_requires_capability("retrieve_knowledge", "knowledge_retrieval").
task_requires_capability("synthesize_context", "context_synthesis").

task_requires_capability("create_plan", "plan_generation").
task_requires_capability("decompose_tasks", "task_decomposition").
task_requires_capability("assess_risk", "risk_assessment").
task_requires_capability("estimate_effort", "resource_planning").

task_requires_capability("execute_action", "action_execution").
task_requires_capability("generate_content", "content_generation").
task_requires_capability("invoke_tool", "tool_invocation").
task_requires_capability("write_code", "code_generation").
task_requires_capability("manipulate_files", "file_operations").

task_requires_capability("validate_output", "validation").
task_requires_capability("check_quality", "quality_check").
task_requires_capability("verify_rules", "rule_validation").
task_requires_capability("check_consistency", "consistency_check").
task_requires_capability("approve_result", "approval").

task_requires_capability("apply_fixes", "error_correction").
task_requires_capability("optimize_quality", "quality_optimization").
task_requires_capability("integrate_feedback", "feedback_integration").
task_requires_capability("generate_patch", "patch_generation").

task_requires_capability("orchestrate_workflow", "workflow_orchestration").
task_requires_capability("delegate_task", "task_delegation").
task_requires_capability("sync_agents", "agent_synchronization").
task_requires_capability("manage_state", "state_management").
task_requires_capability("recover_from_error", "error_recovery").

% ==========================================
% AGENT INSTANCES (Generic)
% ==========================================

agent("observer-001", "observer").
agent("observer-002", "observer").
agent("orienter-001", "orienter").
agent("orienter-002", "orienter").
agent("planner-001", "planner").
agent("executor-001", "executor").
agent("executor-002", "executor").
agent("reviewer-001", "reviewer").
agent("refiner-001", "refiner").
agent("coordinator-001", "coordinator").

