% ==========================================
% PATTERNS - Reusable Execution Patterns
% ==========================================
% Domain-agnostic pattern definitions
% This file is embedded in manglekit binary

% ==========================================
% AGENTIC PATTERNS
% ==========================================

pattern("single_agent").
pattern("multi_agent").
pattern("hierarchical").
pattern("peer_to_peer").
pattern("hub_and_spoke").

% ==========================================
% WORKFLOW PATTERNS
% ==========================================

pattern("sequential").
pattern("parallel").
pattern("pipeline").
pattern("fan_out_fan_in").
pattern("map_reduce").
pattern("event_driven").
pattern("state_machine").

% ==========================================
% EXECUTION PATTERNS
% ==========================================

execution_pattern("blocking").
execution_pattern("non_blocking").
execution_pattern("batch").
execution_pattern("stream").
execution_pattern("scheduled").
execution_pattern("on_demand").

% ==========================================
% FAILURE HANDLING PATTERNS
% ==========================================

failure_pattern("retry").
failure_pattern("fallback").
failure_pattern("circuit_breaker").
failure_pattern("bulkhead").
failure_pattern("timeout").
failure_pattern("dead_letter_queue").

% ==========================================
% COORDINATION PATTERNS
% ==========================================

coordination_pattern("leader_election").
coordination_pattern("two_phase_commit").
coordination_pattern("saga").
coordination_pattern("event_sourcing").
coordination_pattern("cqrs").

% ==========================================
% PATTERN COMBINATIONS
% ==========================================

pattern_combo("robust_pipeline", ["pipeline", "retry", "fallback"]).
pattern_combo("high_throughput", ["parallel", "fan_out_fan_in", "non_blocking"]).
pattern_combo("reliable_execution", ["pipeline", "circuit_breaker", "bulkhead"]).
pattern_combo("distributed_processing", ["multi_agent", "event_driven", "saga"]).

% ==========================================
% PATTERN SELECTION
% ==========================================

pattern_for_requirement("high_availability", "circuit_breaker").
pattern_for_requirement("low_latency", "parallel").
pattern_for_requirement("strong_consistency", "two_phase_commit").
pattern_for_requirement("eventual_consistency", "saga").
pattern_for_requirement("complex_workflow", "state_machine").
pattern_for_requirement("simple_task", "single_agent").
pattern_for_requirement("scalable_task", "multi_agent").
pattern_for_requirement("data_processing", "map_reduce").

% ==========================================
% PATTERN CONSTRAINTS
% ==========================================

pattern_constraint("circuit_breaker", "requires_monitoring").
pattern_constraint("two_phase_commit", "requires_transaction_manager").
pattern_constraint("saga", "requires_compensation_logic").
pattern_constraint("fan_out_fan_in", "requires_barrier_sync").
pattern_constraint("leader_election", "requires_consensus_protocol").