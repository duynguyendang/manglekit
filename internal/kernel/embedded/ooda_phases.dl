% ==========================================
% OODA PHASES - Core Loop Definitions
% ==========================================
% Generic OODA (Observe → Orient → Decide → Act → Verify → Refine)
% Framework for agentic systems
% This file is embedded in manglekit binary

% ==========================================
% PHASE ORDER
% ==========================================

phase_order(1, "observe").
phase_order(2, "orient").
phase_order(3, "decide").
phase_order(4, "act").
phase_order(5, "verify").
phase_order(6, "refine").

% ==========================================
% PHASE DEFINITIONS
% ==========================================

phase("observe", "Context Gathering", "Collect and ingest input from various sources").
phase("orient", "Semantic Synthesis", "Process, classify, and understand the context").
phase("decide", "Strategic Planning", "Select approach and plan execution path").
phase("act", "Execution", "Perform the planned actions").
phase("verify", "Validation", "Check output quality and correctness").
phase("refine", "Iteration", "Self-correct and optimize based on feedback").

% ==========================================
% PHASE CAPABILITIES
% ==========================================

phase_capability("observe", "information_gathering").
phase_capability("observe", "entity_extraction").
phase_capability("observe", "context_capture").
phase_capability("observe", "input_validation").

phase_capability("orient", "semantic_analysis").
phase_capability("orient", "pattern_recognition").
phase_capability("orient", "classification").
phase_capability("orient", "knowledge_retrieval").

phase_capability("decide", "task_decomposition").
phase_capability("decide", "strategy_selection").
phase_capability("decide", "resource_planning").
phase_capability("decide", "risk_assessment").

phase_capability("act", "action_execution").
phase_capability("act", "tool_invocation").
phase_capability("act", "content_generation").
phase_capability("act", "state_update").

phase_capability("verify", "quality_check").
phase_capability("verify", "rule_validation").
phase_capability("verify", "completeness_check").
phase_capability("verify", "consistency_check").

phase_capability("refine", "error_correction").
phase_capability("refine", "quality_optimization").
phase_capability("refine", "feedback_integration").
phase_capability("refine", "iterative_improvement").

% ==========================================
% PHASE TRANSITIONS
% ==========================================

phase_transition("observe", "orient").
phase_transition("orient", "decide").
phase_transition("decide", "act").
phase_transition("act", "verify").
phase_transition("verify", "refine").
phase_transition("refine", "observe").

conditional_transition("verify", "act", "needs_retry").
conditional_transition("verify", "observe", "needs_more_context").
conditional_transition("refine", "decide", "needs_new_strategy").

% ==========================================
% PHASE ACTIONS
% ==========================================

action("observe", "gather_input", "Gather input from user or system").
action("observe", "parse_request", "Parse and normalize request").
action("observe", "extract_entities", "Extract named entities").
action("observe", "validate_format", "Validate input format").

action("orient", "classify_intent", "Classify user intent").
action("orient", "retrieve_knowledge", "Retrieve relevant knowledge").
action("orient", "map_patterns", "Map to known patterns").
action("orient", "synthesize_context", "Build context model").

action("decide", "select_playbook", "Select appropriate playbook").
action("decide", "plan_tasks", "Create task execution plan").
action("decide", "estimate_effort", "Estimate resource needs").
action("decide", "assess_risks", "Identify and assess risks").

action("act", "execute_task", "Execute planned task").
action("act", "generate_content", "Generate requested content").
action("act", "invoke_tool", "Invoke external tool").
action("act", "update_state", "Update system state").

action("verify", "check_quality", "Verify output quality").
action("verify", "validate_rules", "Validate against rules").
action("verify", "check_completeness", "Verify completeness").
action("verify", "measure_accuracy", "Measure output accuracy").

action("refine", "apply_fixes", "Apply corrections").
action("refine", "optimize_output", "Optimize output quality").
action("refine", "incorporate_feedback", "Incorporate feedback").
action("refine", "prepare_retry", "Prepare for retry if needed").

% ==========================================
% PHASE TOOLS
% ==========================================

phase_tool("observe", "semantic_search").
phase_tool("observe", "ner").
phase_tool("observe", "parser").
phase_tool("observe", "validator").

phase_tool("orient", "knowledge_graph").
phase_tool("orient", "vector_store").
phase_tool("orient", "pattern_matcher").
phase_tool("orient", "classifier").

phase_tool("decide", "planner").
phase_tool("decide", "datalog_engine").
phase_tool("decide", "risk_analyzer").
phase_tool("decide", "estimator").

phase_tool("act", "llm").
phase_tool("act", "code_executor").
phase_tool("act", "file_ops").
phase_tool("act", "api_client").

phase_tool("verify", "rule_engine").
phase_tool("verify", "linter").
phase_tool("verify", "test_runner").
phase_tool("verify", "comparator").

phase_tool("refine", "editor").
phase_tool("refine", "optimizer").
phase_tool("refine", "feedback_loop").
phase_tool("refine", "patch_generator").

% ==========================================
% PHASE CONFIGURATION (Defaults)
% ==========================================

phase_config("observe", "max_input_size", "100000").
phase_config("observe", "timeout_ms", "5000").
phase_config("observe", "retry_on_failure", "true").

phase_config("orient", "max_knowledge_results", "20").
phase_config("orient", "confidence_threshold", "0.7").
phase_config("orient", "timeout_ms", "10000").

phase_config("decide", "max_plan_depth", "10").
phase_config("decide", "timeout_ms", "15000").
phase_config("decide", "allow_fallback", "true").

phase_config("act", "timeout_ms", "60000").
phase_config("act", "allow_parallel", "true").
phase_config("act", "checkpoint_interval", "30").

phase_config("verify", "strict_mode", "false").
phase_config("verify", "fail_threshold", "0.8").
phase_config("verify", "timeout_ms", "30000").

phase_config("refine", "max_iterations", "3").
phase_config("refine", "improvement_threshold", "0.1").
phase_config("refine", "timeout_ms", "45000").

% ==========================================
% QUERY HELPERS
% ==========================================

next_phase(Current, Next) :- phase_transition(Current, Next).
next_phase("refine", "observe").

valid_transition(From, To) :- phase_transition(From, To).
valid_transition(From, To) :- conditional_transition(From, To, _).